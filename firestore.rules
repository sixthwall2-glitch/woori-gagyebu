rules_version = '2';
// 두 사람 이메일로 로그인한 경우에만 가계부를 읽고 쓸 수 있습니다.
// Firebase 콘솔 > Firestore > 규칙 에 붙여 넣고 [게시]를 누르세요.
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null
        && request.auth.token.email in ['sixthwall@naver.com', 'hjungg@naver.com'];
    }
    match /entries/{id} {
      allow read: if isFamily();
      allow write: if isFamily()
        && (request.method == 'delete' || (
             request.resource.data.amount is number
             && request.resource.data.amount > 0
             && request.resource.data.type in ['in', 'out']
             && request.resource.data.date is string));
    }
    match /meta/settings {
      allow read, write: if isFamily();
    }
    // 카카오톡 리포트용 연결 정보: 각자 자기 것만 읽고 쓸 수 있습니다. 발송 프로그램은 관리자 키로 읽습니다.
    // 알림 받을 기기 정보: 각자 자기 것만 읽고 씁니다.
    match /push/{uid} {
      allow read, write: if isFamily() && request.auth.uid == uid;
    }
    match /kakao/{uid} {
      allow read, write: if isFamily() && request.auth.uid == uid;
    }
  }
}
